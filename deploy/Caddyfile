# 萌新杯音游比赛平台 — Caddy HTTPS 反向代理模板
#
# 用法：把下面的 example.com 替换为你的域名，然后：
#   caddy run --config Caddyfile
# 或放入 /etc/caddy/Caddyfile 后 systemctl restart caddy。
#
# Caddy 自动申请并续期 Let's Encrypt 证书，自动处理 HTTPS 与 HTTP→HTTPS 跳转。
# reverse_proxy 会自动升级 WebSocket（/ws/* 对局实时推送无需额外配置）。
#
# 备案提醒：
#   - 若服务器位于中国大陆（腾讯云/阿里云大陆节点），域名必须完成 ICP 备案，
#     否则 80/443 端口会被云厂商拦截。
#   - 若使用香港节点（腾讯云/阿里云香港轻量 2C2G），免备案，可直接使用。
#
# 邮箱用于 Let's Encrypt 证书到期提醒，建议填写真实邮箱。

example.com {
    # 证书申请/续期通知邮箱（替换为真实邮箱）
    email admin@example.com

    # 反向代理到后端容器（docker compose 网络内服务名 app:8000）
    # 若为 systemd 裸跑方案，改为 127.0.0.1:8000
    reverse_proxy app:8000
}
